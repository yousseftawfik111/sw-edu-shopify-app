generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Car {
  id           Int         @id @default(autoincrement())
  brand        String
  licensePlate String      @unique
  year         Int
  fuelTypeId   Int
  fuelType     CarFuelType @relation(fields: [fuelTypeId], references: [id])
  driverName   String?
}

model CarFuelType {
  id    Int    @id @default(autoincrement())
  name  String
  cars  Car[]
}
